# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas)
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name
# Replace:
#   - username: Your MongoDB Atlas username
#   - password: Your MongoDB Atlas password (URL-encoded if contains special chars)
#   - cluster-name: Your cluster name (e.g., cluster0)
#   - database-name: Your database name (e.g., bee1)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/restaurant_management

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
